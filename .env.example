# Rename this file to ".env" and uncomment only the variables you need.

# Application
# KSSOLV_LOCALE="en_US"
# KSSOLV_HOST_IN_BROWSER="false"
# Enable browser upload/download and embedded dialogs with Online mode.
# KSSOLV_ONLINE="false"
# Local browser validation: launch with KSSOLV_ONLINE=true and
# KSSOLV_HOST_IN_BROWSER=true. Explicit process variables override .env.
# For headless/proxy hosting, set KSSOLV_BROWSER_SESSION_FILE to an
# absolute writable JSON filename and open the URL published in that file.
# Connect only one browser client to each AppContainer session.

# Materials Project
# MP_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LLM selection
# KSSOLV_LLM_TYPE="Ollama"
# KSSOLV_LLM_MODEL="deepseek-r1:7b"

# Ollama
# KSSOLV_OLLAMA_ENDPOINT="http://127.0.0.1:11434"

# OpenAI-compatible service
# OPENAI_PROXY_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxx"
# OPENAI_MODEL_LIST="gpt-5-mini,gpt-5-nano"
