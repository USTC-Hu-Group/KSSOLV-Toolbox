{
  "name": "@kssolv/crystal-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:check": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc"
  },
  "dependencies": {
    "@kssolv/atomic-scene": "workspace:*",
    "@kssolv/matlab-bridge": "workspace:*",
    "@kssolv/three-scene": "workspace:*",
    "three": "0.185.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "0.185.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.8.4",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
