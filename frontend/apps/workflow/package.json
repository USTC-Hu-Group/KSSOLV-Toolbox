{
  "name": "@kssolv/workflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node ../../scripts/copy-workflow-assets.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "pnpm format && pnpm lint:eslint --fix",
    "lint:check": "pnpm lint:prettier && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "typecheck": "vue-tsc"
  },
  "dependencies": {
    "@kssolv/matlab-bridge": "workspace:*",
    "@antv/x6": "^2.19.2",
    "@antv/x6-plugin-clipboard": "^2.1.6",
    "@antv/x6-plugin-history": "^2.2.4",
    "@antv/x6-plugin-keyboard": "^2.2.3",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-snapline": "^2.1.7",
    "@antv/x6-vue-shape": "^2.1.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
